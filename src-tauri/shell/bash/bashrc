# TermPaper shell integration shim: run the user's real bash startup, then add OSC 133 marks.
[[ -f "$HOME/.bashrc" ]] && source "$HOME/.bashrc"

# C = output start. PS0 (bash 4.4+) prints it after Enter; older bash falls back to a
# DEBUG trap that fires once per command line.
if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4))); then
  PS0="${PS0}"$'\e]133;C\a'
else
  __termpaper_preexec() {
    [[ -n "$__termpaper_ready" ]] || return
    __termpaper_ready=
    printf '\e]133;C\a'
  }
  trap '__termpaper_preexec' DEBUG
fi
# A = prompt start, B = command input start. Both live inside PS1 (wrapped in \[ \]
# so readline's width maths ignores them). Re-applied last in PROMPT_COMMAND because
# prompt frameworks rebuild PS1 on every prompt.
__termpaper_prompt() {
  __termpaper_ready=1
  [[ "$PS1" == *']133;A'* ]] || PS1='\[\e]133;A\a\]'"${PS1}"'\[\e]133;B\a\]'
}
if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
  PROMPT_COMMAND+=(__termpaper_prompt)
else
  PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}__termpaper_prompt"
fi
