# TermPaper look for Ghostty (Reishi.dev). Install: see README.md in this folder.
theme = TermPaper Fountain Pen
font-family = Monaspace Radon
font-size = 17
adjust-cell-height = 60%
cursor-style = underline
cursor-style-blink = true
window-theme = light
# tabs sit in the title bar, which takes the paper color; traffic lights stay
macos-titlebar-style = tabs
# left padding leaves room for the binder holes and margin line
window-padding-x = 84,24
window-padding-y = 24
# paper, rules, margin, holes, pressed-in ink
background-image = termpaper/paper.png
background-image-repeat = true
background-image-fit = none
custom-shader = termpaper/paper.glsl
